# Copy this file to .env and fill in the values.
# Never put real secrets in this file. It is committed to Git.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string.
# Get it from Atlas: Database > Connect > Drivers. Replace USERNAME and PASSWORD.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER_HOST/?retryWrites=true&w=majority

# Use a different database name for development, testing and production.
MONGODB_DB_NAME=devlance_dev

# Websites that are allowed to call this API from a browser (comma-separated).
# Only scheme, host and port. No trailing slash, no path.
# Required in production, for example: https://your-site.vercel.app
CLIENT_ORIGINS=http://localhost:5173

# How many reverse proxies sit in front of this server.
# 0 on your own computer. Usually 1 on hosting platforms like Render.
TRUST_PROXY=0

# Optional. Only set this if your network cannot resolve the Atlas address
# (error: querySrv ECONNREFUSED). Comma-separated DNS server IPs.
# DNS_SERVERS=8.8.8.8,1.1.1.1